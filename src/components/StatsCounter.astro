---
import { siteConfig } from '../data/pageContent';

const statIcons = ['rocket_launch', 'sentiment_satisfied', 'support_agent', 'workspace_premium'];
---

<section class="py-12 bg-white border-b border-slate-200/80 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {siteConfig.stats.map((stat, idx) => (
        <div class="flex items-center gap-4 p-5 sm:p-6 bg-slate-50 hover:bg-sky-50/50 border border-slate-200 rounded-2xl transition-all duration-200 hover:border-sky-300 hover:shadow-md">
          <div class="w-12 h-12 rounded-xl bg-sky-100/80 text-sky-700 flex items-center justify-center shrink-0 border border-sky-200/80">
            <span class="material-symbols-outlined text-[24px]">{statIcons[idx % statIcons.length]}</span>
          </div>
          <div class="flex flex-col">
            <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              {stat.value}
            </span>
            <span class="text-xs sm:text-sm font-semibold text-slate-600">
              {stat.label}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
