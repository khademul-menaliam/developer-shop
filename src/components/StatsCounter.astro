---
import { siteConfig } from '../data/pageContent';
---

<section class="py-12 bg-slate-50 border-b border-slate-200/80 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {siteConfig.stats.map(stat => (
        <div class="flex flex-col p-6 bg-white border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
          <span class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            {stat.value}
          </span>
          <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1.5 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
