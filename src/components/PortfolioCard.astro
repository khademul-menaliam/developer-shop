---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  project: PortfolioItem;
}

const { project } = Astro.props;
---

<div class="group flex flex-col bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5">
  <!-- Project Screenshot Container -->
  <div class="relative w-full h-60 bg-slate-900 overflow-hidden">
    <img
      src={project.image_url}
      alt={project.title}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>
    <div class="absolute top-4 left-4">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-900/90 backdrop-blur-md text-emerald-400 border border-slate-700/80 shadow-md">
        {project.category}
      </span>
    </div>
    <div class="absolute bottom-3 left-5 right-5 text-xs font-semibold text-slate-300 flex items-center justify-between">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        {project.client}
      </span>
      <span class="text-slate-400 font-medium">{project.year}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-7 flex flex-col flex-1 justify-between">
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight mb-2 group-hover:text-emerald-600 transition-colors">
        <a href={`/portfolio/${project.slug}`} class="focus:outline-none">
          {project.title}
        </a>
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5">
        {project.summary}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 mb-6">
        {project.tags.map(tag => (
          <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200/60">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Link to Case Study -->
    <div class="pt-5 border-t border-slate-100 flex items-center justify-between">
      <a
        href={`/portfolio/${project.slug}`}
        class="text-xs sm:text-sm font-bold text-emerald-600 hover:text-emerald-700 inline-flex items-center gap-1.5 group/link"
      >
        <span>View Case Study</span>
        <span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
      </a>

      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-400 bg-slate-50 px-2.5 py-1 rounded-md border border-slate-100">
        <span class="material-symbols-outlined text-[14px] text-emerald-500">verified</span>
        <span>Verified Impact</span>
      </span>
    </div>
  </div>
</div>
