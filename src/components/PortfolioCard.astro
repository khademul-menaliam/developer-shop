---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  project: PortfolioItem;
}

const { project } = Astro.props;
---

<div class="group flex flex-col bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
  <!-- Project Screenshot Container -->
  <div class="relative w-full h-56 bg-slate-900 overflow-hidden">
    <img
      src={project.image_url}
      alt={project.title}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
    <div class="absolute top-4 left-4">
      <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-900/80 backdrop-blur-md text-emerald-400 border border-slate-700/80 shadow-sm">
        {project.category}
      </span>
    </div>
    <div class="absolute bottom-3 left-4 right-4 text-xs font-medium text-slate-300 flex items-center justify-between">
      <span>{project.client}</span>
      <span class="text-slate-400">{project.year}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <h3 class="text-lg font-bold text-slate-900 tracking-tight mb-2 group-hover:text-emerald-600 transition-colors">
        <a href={`/portfolio/${project.slug}`}>
          {project.title}
        </a>
      </h3>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        {project.summary}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 mb-6">
        {project.tags.map(tag => (
          <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 text-slate-600">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Link to Case Study -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
      <a
        href={`/portfolio/${project.slug}`}
        class="text-xs font-bold text-emerald-600 hover:text-emerald-700 inline-flex items-center gap-1 group/link"
      >
        <span>Read Case Study</span>
        <span class="material-symbols-outlined text-[16px] group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
      </a>

      <span class="text-[11px] font-semibold text-slate-400">Verified Result</span>
    </div>
  </div>
</div>
