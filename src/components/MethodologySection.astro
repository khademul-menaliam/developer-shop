---
import { methodologySteps } from '../data/pageContent';
---

<section class="w-full py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="process">
  <div class="flex flex-col gap-12">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-2">
      <span class="text-xs font-bold text-sky-700 uppercase tracking-widest bg-sky-50 px-3.5 py-1 rounded-full w-fit mx-auto border border-sky-200">
        How We Work
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">
        Our Simple 4-Step Delivery Process
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        A transparent, structured workflow engineered to eliminate delays and deliver production-ready software on schedule.
      </p>
    </div>

    <!-- 4 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {methodologySteps.map((step, index) => (
        <div class="bg-white p-7 rounded-3xl border border-slate-200 shadow-xs flex flex-col gap-5 relative group hover:border-sky-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-sky-700 bg-sky-50 px-3 py-1 rounded-full border border-sky-200">
              STEP {step.step}
            </span>
            <div class="w-12 h-12 rounded-2xl bg-sky-50 group-hover:bg-sky-600 group-hover:text-white text-sky-600 flex items-center justify-center transition-all duration-300 shadow-xs">
              <span class="material-symbols-outlined text-[24px]">{step.icon}</span>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900 tracking-tight mb-2 group-hover:text-sky-600 transition-colors">
              {step.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
