---
import { siteConfig } from '../data/pageContent';

const techStack = [
  { name: 'Astro 5.0', icon: 'rocket_launch' },
  { name: 'React / Next.js', icon: 'code_blocks' },
  { name: 'TypeScript', icon: 'integration_instructions' },
  { name: 'Node.js & Python', icon: 'terminal' },
  { name: 'PostgreSQL & Supabase', icon: 'database' },
  { name: 'AWS & Vercel Edge', icon: 'cloud_done' },
  { name: 'Tailwind CSS', icon: 'palette' },
  { name: 'Firebase & Cloud', icon: 'local_fire_department' },
  { name: 'Mobile Apps (iOS/Android)', icon: 'phone_iphone' },
  { name: 'Zero-Downtime CI/CD', icon: 'sync_saved_locally' }
];
---

<section class="relative w-full bg-[#0F172A] text-slate-200 pt-12 pb-16 md:pt-16 md:pb-24 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Subtle Grid & Radial Glow Background -->
  <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px]"></div>
  <div class="absolute -right-20 -top-20 w-[30rem] h-[30rem] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute left-1/4 -bottom-20 w-[24rem] h-[24rem] bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Copy Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6 text-left">
        <!-- Top Trust Rating Pill (Riseup Labs & Bizcope style) -->
        <div class="inline-flex items-center gap-2.5 bg-slate-800/80 text-slate-200 px-4 py-1.5 rounded-full w-fit text-xs font-semibold border border-slate-700/80 shadow-md">
          <div class="flex text-amber-400">
            <span class="material-symbols-outlined text-[14px]">star</span>
            <span class="material-symbols-outlined text-[14px]">star</span>
            <span class="material-symbols-outlined text-[14px]">star</span>
            <span class="material-symbols-outlined text-[14px]">star</span>
            <span class="material-symbols-outlined text-[14px]">star</span>
          </div>
          <span class="text-slate-500">|</span>
          <span class="text-emerald-400 font-bold">4.9/5 Rating</span>
          <span class="text-slate-400 hidden sm:inline">• 1,500+ Projects Delivered</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold text-white tracking-tight leading-[1.15]">
          Engineering High-Performance Web & Digital Systems for <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">Growing Enterprises</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed font-normal">
          From high-converting business websites to custom cloud portals and mobile applications — we build lightning-fast, ultra-reliable digital solutions with full source code ownership.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <a
            href="/booking"
            class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white px-7 h-13 rounded-xl text-sm font-bold transition-all duration-200 shadow-xl shadow-emerald-500/25 hover:scale-[1.02] border border-emerald-400/30"
          >
            <span class="material-symbols-outlined text-[20px]">calendar_month</span>
            <span>Get Free Project Estimation</span>
          </a>

          <a
            href="/services"
            class="inline-flex items-center justify-center gap-2 border border-slate-700 bg-slate-800/80 hover:bg-slate-800 text-slate-200 hover:text-white px-6 h-13 rounded-xl text-sm font-semibold transition-all duration-200"
          >
            <span>Explore Services</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        </div>

        <!-- Quick Trust Guarantee Checklist -->
        <div class="pt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-300 font-medium border-t border-slate-800/80">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[14px]">check</span>
            </span>
            <span>Direct Senior Engineer Access</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[14px]">check</span>
            </span>
            <span>$0 Monthly Hosting Options</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[14px]">check</span>
            </span>
            <span>100% Code Ownership</span>
          </div>
        </div>
      </div>

      <!-- Right Interactive Telemetry & Agency Proof Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="bg-slate-900/90 backdrop-blur-2xl border border-slate-700/80 p-6 sm:p-8 rounded-3xl shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-40 h-40 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex flex-col gap-6">
            <!-- Header status -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
              <div class="flex items-center gap-2.5">
                <span class="relative flex h-3 w-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Enterprise SLA Status</span>
              </div>
              <span class="text-[11px] px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">
                100% Operational
              </span>
            </div>

            <!-- Uptime Metric -->
            <div class="flex justify-between items-end">
              <div>
                <span class="text-xs text-slate-400 block font-medium">Production Availability</span>
                <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">99.98% Uptime</span>
              </div>
              <div class="text-right">
                <span class="text-xs text-emerald-400 font-bold block">Avg Speed Score</span>
                <span class="text-2xl font-extrabold text-emerald-400">98 / 100</span>
              </div>
            </div>

            <!-- Progress bar -->
            <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-700/50">
              <div class="bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 h-full rounded-full w-[99.9%]"></div>
            </div>

            <!-- Key Agency Specs -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Average Response Time</span>
                <span class="text-white font-extrabold text-base">&lt; 38 ms</span>
              </div>
              <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Client Satisfaction</span>
                <span class="text-emerald-400 font-extrabold text-base">99.2%</span>
              </div>
            </div>

            <!-- Quick WhatsApp booking prompt -->
            <div class="bg-emerald-950/30 border border-emerald-500/30 rounded-2xl p-4 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">chat</span>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-white">Need a Fast Quote?</h4>
                  <p class="text-[11px] text-slate-300">Talk directly with a technical consultant</p>
                </div>
              </div>
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold rounded-lg transition-colors shrink-0"
              >
                Chat Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Modern Technology Stack Marquee (Nextzen & Riseup Labs style) -->
    <div class="mt-16 pt-8 border-t border-slate-800/80">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">
        Modern Technologies & Platforms We Specialize In
      </p>

      <div class="relative overflow-hidden w-full [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
        <div class="animate-marquee flex items-center gap-6">
          {techStack.concat(techStack).map((tech) => (
            <div class="flex items-center gap-2 bg-slate-800/60 hover:bg-slate-800 border border-slate-700/80 px-4 py-2 rounded-xl text-xs font-semibold text-slate-200 whitespace-nowrap transition-colors">
              <span class="material-symbols-outlined text-[16px] text-emerald-400">{tech.icon}</span>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
