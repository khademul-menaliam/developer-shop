---
import { siteConfig } from '../data/pageContent';

const techStack = [
  { name: 'Astro 5.0', icon: 'rocket_launch' },
  { name: 'React / Next.js', icon: 'code_blocks' },
  { name: 'TypeScript', icon: 'integration_instructions' },
  { name: 'Node.js & Python', icon: 'terminal' },
  { name: 'PostgreSQL & Supabase', icon: 'database' },
  { name: 'AWS & Vercel Edge', icon: 'cloud_done' },
  { name: 'Tailwind CSS', icon: 'palette' },
  { name: 'Firebase & Cloud', icon: 'local_fire_department' },
  { name: 'Mobile Apps (iOS/Android)', icon: 'phone_iphone' },
  { name: 'Zero-Downtime CI/CD', icon: 'sync_saved_locally' }
];
---

<section class="relative w-full bg-slate-950 text-slate-200 pt-16 pb-16 md:pt-20 md:pb-24 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Subtle Grid & Sapphire Glow Background -->
  <div class="absolute inset-0 opacity-[0.04] bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
  <div class="absolute -right-20 -top-20 w-96 h-96 bg-sky-500/[0.08] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute left-1/4 -bottom-20 w-80 h-80 bg-sky-600/[0.05] rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Left Copy Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6 text-left">
        <!-- Top Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs font-medium w-fit shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-200 font-semibold">Available for Q4 Projects</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-400">Direct Senior Engineering</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold text-white tracking-tight leading-[1.15]">
          Engineering High-Performance Digital Systems for <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-sky-300 to-cyan-300">Modern Enterprise</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed font-normal">
          From fast, scalable web apps to custom cloud platforms and mobile solutions — we engineer reliable software with full source code ownership.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          <a
            href="/booking"
            class="inline-flex items-center justify-center gap-2 bg-sky-600 hover:bg-sky-500 text-white px-6 h-12 rounded-xl text-sm font-bold transition-all duration-200 shadow-lg shadow-sky-950/40 hover:-translate-y-0.5 border border-sky-400/30"
          >
            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
            <span>Get Free Estimation</span>
          </a>

          <a
            href="/services"
            class="inline-flex items-center justify-center gap-2 border border-slate-800 bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white px-5 h-12 rounded-xl text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>Explore Services</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        </div>

        <!-- Clean Key Guarantees -->
        <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-400 border-t border-slate-800/80">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] text-sky-400">verified</span>
            <span class="text-slate-300 font-medium">100% Code Ownership</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] text-sky-400">speed</span>
            <span class="text-slate-300 font-medium">99.98% Uptime SLA</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px] text-sky-400">engineering</span>
            <span class="text-slate-300 font-medium">Zero-Vendor Lock-in</span>
          </div>
        </div>
      </div>

      <!-- Right Streamlined System Overview Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl p-6 shadow-2xl relative overflow-hidden">
          <!-- Card Header / Mac Style Dots -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="text-xs text-slate-400 font-mono ml-2">system-health.ts</span>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>100% Operational</span>
            </span>
          </div>

          <!-- Concise Metrics Grid -->
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-slate-950/70 p-4 rounded-xl border border-slate-800/80">
                <span class="text-xs text-slate-400 block mb-1">Infrastructure Availability</span>
                <span class="text-2xl font-extrabold text-white tracking-tight">99.98%</span>
                <span class="text-[11px] text-emerald-400 block mt-0.5">High-Availability SLA</span>
              </div>
              <div class="bg-slate-950/70 p-4 rounded-xl border border-slate-800/80">
                <span class="text-xs text-slate-400 block mb-1">Performance Score</span>
                <span class="text-2xl font-extrabold text-sky-400 tracking-tight">99 / 100</span>
                <span class="text-[11px] text-slate-400 block mt-0.5">Lighthouse Core Web</span>
              </div>
            </div>

            <!-- Quick Direct Consultation Row -->
            <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0 border border-sky-500/20">
                  <span class="material-symbols-outlined text-[18px]">chat</span>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-white">Have a Project in Mind?</h4>
                  <p class="text-[11px] text-slate-400">Chat directly with senior tech lead</p>
                </div>
              </div>
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold rounded-lg transition-colors shrink-0 shadow-sm"
              >
                Chat Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Modern Technology Stack Marquee -->
    <div class="mt-16 pt-8 border-t border-slate-800">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">
        Modern Technologies & Platforms We Specialize In
      </p>

      <div class="relative overflow-hidden w-full [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
        <div class="animate-marquee flex items-center gap-6">
          {techStack.concat(techStack).map((tech) => (
            <div class="flex items-center gap-2 bg-slate-900 hover:bg-slate-850 border border-slate-800 hover:border-sky-500/40 px-4 py-2 rounded-xl text-xs font-semibold text-slate-200 whitespace-nowrap transition-colors">
              <span class="material-symbols-outlined text-[16px] text-sky-400">{tech.icon}</span>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
