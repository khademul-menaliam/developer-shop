---
import { siteConfig } from '../data/pageContent';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0F172A]/95 backdrop-blur-md border-b border-slate-800 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-20 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="/" class="flex flex-col group">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-[20px]">terminal</span>
          </div>
          <span class="text-xl font-bold tracking-tight text-white group-hover:text-emerald-400 transition-colors">
            {siteConfig.name}
          </span>
        </div>
        <span class="text-[11px] font-medium text-slate-400 tracking-wide pl-10 -mt-1 hidden sm:block">
          {siteConfig.tagline}
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 bg-slate-900/60 p-1.5 rounded-xl border border-slate-800">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all duration-200 ${
              isActive(link.href)
                ? 'bg-emerald-500 text-white shadow-sm shadow-emerald-500/20 font-semibold'
                : 'text-slate-300 hover:text-white hover:bg-slate-800/80'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Actions: Call & WhatsApp -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
          class="inline-flex items-center justify-center gap-1.5 border border-slate-700 bg-slate-800/40 text-slate-200 hover:text-white hover:bg-slate-800 hover:border-slate-600 px-3.5 h-10 rounded-xl text-xs font-semibold transition-all duration-200"
        >
          <span class="material-symbols-outlined text-[16px] text-emerald-400">call</span>
          <span>Call Us</span>
        </a>

        <a
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-white px-4 h-10 rounded-xl text-xs font-bold transition-all duration-200 shadow-md shadow-emerald-500/20 hover:scale-[1.02]"
        >
          <span class="material-symbols-outlined text-[16px]">chat</span>
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-emerald-500 text-white flex items-center justify-center"
          aria-label="WhatsApp"
        >
          <span class="material-symbols-outlined text-[18px]">chat</span>
        </a>

        <button
          id="mobile-menu-button"
          type="button"
          class="p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-800 transition-colors"
          aria-label="Open menu"
        >
          <span class="material-symbols-outlined text-[24px]" id="menu-icon">menu</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-[#0F172A] px-4 pt-3 pb-6 space-y-3">
    <div class="flex flex-col space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            isActive(link.href)
              ? 'bg-emerald-500/15 text-emerald-400 font-semibold border border-emerald-500/30'
              : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
          }`}
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="pt-3 border-t border-slate-800 grid grid-cols-2 gap-2">
      <a
        href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
        class="inline-flex items-center justify-center gap-1.5 border border-slate-700 bg-slate-800/60 text-slate-200 px-3 py-2.5 rounded-xl text-xs font-semibold"
      >
        <span class="material-symbols-outlined text-[16px] text-emerald-400">call</span>
        <span>Call Now</span>
      </a>

      <a
        href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 bg-emerald-500 text-white px-3 py-2.5 rounded-xl text-xs font-bold"
      >
        <span class="material-symbols-outlined text-[16px]">chat</span>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  if (button && menu && icon) {
    button.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      icon.textContent = isHidden ? 'menu' : 'close';
    });
  }
</script>
