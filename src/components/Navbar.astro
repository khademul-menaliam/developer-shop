---
import { siteConfig } from '../data/pageContent';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'Pricing', href: '/#pricing' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- 1. Top Utility Contact Bar -->
  <div class="bg-slate-950 text-slate-400 text-xs py-2 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 hidden sm:block">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- Left Contact Info -->
      <div class="flex items-center gap-6">
        <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-sky-300 transition-colors">
          <span class="material-symbols-outlined text-[15px] text-sky-400">call</span>
          <span>{siteConfig.phoneDisplay}</span>
        </a>
        <a href={`mailto:${siteConfig.email}`} class="inline-flex items-center gap-1.5 hover:text-sky-300 transition-colors">
          <span class="material-symbols-outlined text-[15px] text-sky-400">mail</span>
          <span>{siteConfig.email}</span>
        </a>
        <span class="text-slate-700 hidden lg:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-slate-400 hidden lg:inline-flex">
          <span class="material-symbols-outlined text-[15px] text-sky-400">schedule</span>
          <span>{siteConfig.workingHours}</span>
        </span>
      </div>

      <!-- Right Direct Action & Location -->
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1 text-slate-400">
          <span class="material-symbols-outlined text-[15px] text-sky-400">location_on</span>
          <span>Dhaka, Bangladesh</span>
        </span>
        <span class="text-slate-700">|</span>
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sky-300 hover:text-white font-medium transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
          <span>Live WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Main Navigation Bar -->
  <div class="bg-slate-900/95 backdrop-blur-xl border-b border-slate-800/80 shadow-lg shadow-slate-950/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="h-20 flex items-center justify-between">
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-600 to-sky-700 border border-sky-400/30 flex items-center justify-center text-white group-hover:scale-105 transition-all shadow-md shadow-sky-950/30">
            <span class="material-symbols-outlined text-[22px]">terminal</span>
          </div>
          <div class="flex flex-col">
            <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white group-hover:text-sky-300 transition-colors">
              {siteConfig.name}
            </span>
            <span class="text-[11px] font-medium text-slate-400 tracking-wide -mt-0.5">
              Software & Digital Systems
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-950/80 p-1.5 rounded-xl border border-slate-800">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 ${
                isActive(link.href)
                  ? 'bg-sky-600 text-white shadow-sm font-bold'
                  : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
              }`}
            >
              {link.name}
            </a>
          ))}
        </nav>

        <!-- Desktop Actions: Free Consultation CTA -->
        <div class="hidden sm:flex items-center gap-3">
          <a
            href="/booking"
            class="inline-flex items-center justify-center gap-2 bg-sky-600 hover:bg-sky-500 text-white px-5 h-11 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 shadow-md shadow-sky-950/40 hover:scale-[1.02] border border-sky-400/30"
          >
            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
            <span>Free Consultation</span>
          </a>
        </div>

        <!-- Mobile Hamburger Button -->
        <div class="flex items-center gap-2 md:hidden">
          <a
            href="/booking"
            class="px-3.5 py-1.5 rounded-lg bg-sky-600 text-white text-xs font-bold"
          >
            Quote
          </a>

          <button
            id="mobile-menu-button"
            type="button"
            class="p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-800 transition-colors"
            aria-label="Open menu"
          >
            <span class="material-symbols-outlined text-[24px]" id="menu-icon">menu</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-3 shadow-2xl">
    <div class="flex flex-col space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors ${
            isActive(link.href)
              ? 'bg-sky-600 text-white font-bold'
              : 'text-slate-300 hover:text-white hover:bg-slate-900'
          }`}
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="pt-3 border-t border-slate-800 flex flex-col gap-2">
      <a
        href="/booking"
        class="inline-flex items-center justify-center gap-2 bg-sky-600 text-white px-4 py-3 rounded-xl text-sm font-bold shadow-md"
      >
        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
        <span>Schedule Free Consultation</span>
      </a>

      <div class="grid grid-cols-2 gap-2 pt-1">
        <a
          href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
          class="inline-flex items-center justify-center gap-1.5 border border-slate-700 bg-slate-900 text-slate-200 px-3 py-2.5 rounded-xl text-xs font-semibold"
        >
          <span class="material-symbols-outlined text-[16px]">call</span>
          <span>Call Now</span>
        </a>

        <a
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 border border-slate-700 bg-slate-900 text-white px-3 py-2.5 rounded-xl text-xs font-bold"
        >
          <span class="material-symbols-outlined text-[16px] text-sky-400">chat</span>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  if (button && menu && icon) {
    button.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      icon.textContent = isHidden ? 'menu' : 'close';
    });
  }
</script>
