---
import { siteConfig } from '../data/pageContent';
---

<section class="w-full bg-slate-50 py-20 px-4 sm:px-6 lg:px-8 border-y border-slate-200/80" id="pricing">
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-2">
      <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full w-fit mx-auto border border-emerald-200">
        Accessible & Flexible
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">
        Transparent & Budget-Friendly Plans
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        We work within your budget. From free cloud-hosted personal portfolios to industrial-grade platforms, we never say no to a great project.
      </p>
    </div>

    <!-- Pricing 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      <!-- Tier 1: Solo Portfolio ($0/mo) -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-7 sm:p-8 shadow-sm flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <div class="flex flex-col gap-5">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Entry Level</span>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight mt-1">Solo & Personal Portfolio</h3>
            <p class="text-slate-600 text-xs mt-1">Zero server costs for freelancers, consultants & creators</p>
          </div>

          <div class="flex flex-col">
            <div class="flex items-baseline gap-1.5">
              <span class="text-4xl font-extrabold text-slate-900 tracking-tight">$0</span>
              <span class="text-xs text-slate-500 font-semibold">/ mo Hosting</span>
            </div>
            <span class="text-[11px] text-slate-400 mt-1 font-medium">(Nominal one-time design setup)</span>
          </div>

          <div class="pt-3 border-t border-slate-100">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>100% Free deployment on Vercel / Netlify edge</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Free database setup on Supabase free tier</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Custom domain connection & free lifetime SSL</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Fast, mobile-first responsive design (<1s load)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Direct WhatsApp & click-to-call integration</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6">
          <a
            href="/booking?plan=Solo%20Portfolio"
            class="w-full inline-flex items-center justify-center border-2 border-emerald-500 text-emerald-600 hover:bg-emerald-50 h-11 rounded-xl text-xs font-bold transition-colors shadow-sm"
          >
            Build My Portfolio
          </a>
        </div>
      </div>

      <!-- Tier 2: Small Business & Growth (Featured: Name Your Budget) -->
      <div class="bg-white rounded-3xl border-2 border-emerald-500 p-7 sm:p-8 shadow-xl flex flex-col justify-between relative hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-[11px] font-extrabold uppercase tracking-widest px-4 py-1 rounded-full shadow-md">
          Most Flexible
        </div>

        <div class="flex flex-col gap-5">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Popular Choice</span>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight mt-1">Small Business & Growth</h3>
            <p class="text-slate-600 text-xs mt-1">We match our development scope to your exact budget</p>
          </div>

          <div class="flex flex-col">
            <div class="flex items-baseline gap-1">
              <span class="text-2xl sm:text-3xl font-extrabold text-emerald-600 tracking-tight">Name Your Budget</span>
            </div>
            <span class="text-[11px] text-slate-500 mt-1 font-medium">Transparent & milestone-based</span>
          </div>

          <div class="pt-3 border-t border-slate-100">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Tailored scope based on what you want to invest</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Multi-page business website or web catalog</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Domain, DNS & professional Google Workspace email</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>WhatsApp lead capture & customer inquiry database</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Hands-off monthly maintenance & security patches</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6">
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hello! I would like to propose my project budget for Millennium Dev Labs.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-white h-11 rounded-xl text-xs font-bold transition-all shadow-md shadow-emerald-500/20"
          >
            <span class="material-symbols-outlined text-[16px]">chat</span>
            <span>Propose Your Budget</span>
          </a>
        </div>
      </div>

      <!-- Tier 3: Industrial & Mobile Apps (Custom Quote) -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-7 sm:p-8 shadow-sm flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <div class="flex flex-col gap-5">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Enterprise</span>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight mt-1">Industrial & Mobile Apps</h3>
            <p class="text-slate-600 text-xs mt-1">Advanced platforms, custom software & iOS/Android apps</p>
          </div>

          <div class="flex flex-col">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-extrabold text-slate-900 tracking-tight">Custom</span>
              <span class="text-xs text-slate-500 font-semibold">Quote</span>
            </div>
            <span class="text-[11px] text-slate-400 mt-1 font-medium">Tailored enterprise architecture</span>
          </div>

          <div class="pt-3 border-t border-slate-100">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Industrial portals & custom ERP/CRM backends</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Android & iOS cross-platform mobile apps</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Scalable PostgreSQL database & custom RESTful APIs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>Cloudinary image CDN & asset optimization</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
                <span>24/7 telemetry monitoring & SLA guaranteed response</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6">
          <a
            href="/booking?plan=Industrial%20Custom"
            class="w-full inline-flex items-center justify-center bg-slate-900 hover:bg-slate-800 text-white h-11 rounded-xl text-xs font-bold transition-colors shadow-sm"
          >
            Request Custom Quote
          </a>
        </div>
      </div>
    </div>

    <!-- Direct Budget Callout Banner -->
    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 text-center shadow-sm flex flex-col sm:flex-row items-center justify-center gap-3">
      <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[20px]">chat</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed text-center sm:text-left">
        <strong class="text-slate-900 font-semibold">Have a unique requirement or tight initial budget?</strong>
        Send us a quick message with your project goals, and we will configure a custom deliverable package for you.
      </p>
    </div>
  </div>
</section>
