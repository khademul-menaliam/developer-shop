---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
---

<div class={`flex flex-col bg-white border ${featured ? 'border-emerald-500/50 shadow-md ring-1 ring-emerald-500/20' : 'border-slate-200/90 shadow-sm'} p-6 sm:p-7 rounded-2xl transition-all duration-200 hover:shadow-lg hover:-translate-y-1 justify-between relative`}>
  {service.badge && (
    <div class="absolute top-6 right-6">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
        {service.badge}
      </span>
    </div>
  )}

  <div>
    <!-- Icon -->
    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 border border-emerald-100">
      <span class="material-symbols-outlined text-[26px]">{service.icon}</span>
    </div>

    <!-- Title & Audience -->
    <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-1">
      <a href={`/services/${service.slug}`} class="hover:text-emerald-600 transition-colors">
        {service.title}
      </a>
    </h3>
    <p class="text-xs font-semibold text-emerald-700 mb-3">
      {service.target_audience}
    </p>

    <p class="text-slate-600 text-sm leading-relaxed mb-6">
      {service.short_description}
    </p>

    <!-- Deliverables Checklist -->
    <div class="mb-6 pt-4 border-t border-slate-100">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
        Key Capabilities Included
      </p>
      <ul class="space-y-2 text-xs font-medium text-slate-600">
        {service.features.slice(0, 4).map(item => (
          <li class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-emerald-500 shrink-0 mt-0.5">check_circle</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom CTA & Price -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
    <a
      href={`/services/${service.slug}`}
      class="text-emerald-600 font-bold text-xs hover:text-emerald-700 transition-colors inline-flex items-center gap-1 group"
    >
      <span>Full Specifications</span>
      <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
    </a>

    <a
      href={`/booking?service=${encodeURIComponent(service.title)}`}
      class="text-xs bg-slate-900 hover:bg-slate-800 text-white font-semibold px-3 py-1.5 rounded-lg transition-colors"
    >
      Inquire
    </a>
  </div>
</div>
