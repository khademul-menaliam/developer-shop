---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
---

<div class={`group flex flex-col bg-white border ${featured ? 'border-sky-500 shadow-lg ring-2 ring-sky-500/10' : 'border-slate-200 shadow-xs'} p-7 sm:p-8 rounded-3xl transition-all duration-300 hover:shadow-xl hover:border-sky-300 hover:-translate-y-1.5 justify-between relative overflow-hidden`}>
  {service.badge && (
    <div class="absolute top-6 right-6">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200/80 shadow-xs">
        {service.badge}
      </span>
    </div>
  )}

  <div>
    <!-- Icon with soft sapphire background -->
    <div class="w-14 h-14 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center mb-6 border border-sky-100 group-hover:scale-110 group-hover:bg-sky-600 group-hover:text-white transition-all duration-300 shadow-xs">
      <span class="material-symbols-outlined text-[28px]">{service.icon}</span>
    </div>

    <!-- Title & Audience -->
    <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-1.5 group-hover:text-sky-600 transition-colors">
      <a href={`/services/${service.slug}`} class="focus:outline-none">
        {service.title}
      </a>
    </h3>
    <p class="text-xs font-semibold text-slate-500 mb-4 flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
      <span>{service.target_audience}</span>
    </p>

    <p class="text-slate-600 text-sm leading-relaxed mb-6">
      {service.short_description}
    </p>

    <!-- Deliverables Checklist -->
    <div class="mb-6 pt-5 border-t border-slate-100">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
        Key Capabilities Included
      </p>
      <ul class="space-y-2.5 text-xs font-medium text-slate-700">
        {service.features.slice(0, 4).map(item => (
          <li class="flex items-start gap-2.5">
            <span class="w-4 h-4 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center shrink-0 mt-0.5">
              <span class="material-symbols-outlined text-[12px]">check</span>
            </span>
            <span class="leading-tight">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom CTA & Pricing hint -->
  <div class="pt-5 border-t border-slate-100 flex items-center justify-between gap-3">
    <a
      href={`/services/${service.slug}`}
      class="text-sky-600 font-bold text-xs hover:text-sky-800 transition-colors inline-flex items-center gap-1 group/link"
    >
      <span>Explore Specs</span>
      <span class="material-symbols-outlined text-[16px] group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
    </a>

    <a
      href={`/booking?service=${encodeURIComponent(service.title)}`}
      class="text-xs bg-slate-900 hover:bg-sky-600 text-white font-bold px-4 py-2 rounded-xl transition-all duration-200 shadow-sm hover:shadow-sky-950/20"
    >
      Get Quote
    </a>
  </div>
</div>
