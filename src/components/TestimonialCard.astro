---
import type { Testimonial } from '../data/pageContent';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<div class="bg-white border border-slate-200/90 p-7 sm:p-8 rounded-3xl shadow-sm flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative">
  <div>
    <!-- Rating Stars & Google/Clutch verification -->
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-1 text-amber-400">
        {Array.from({ length: testimonial.rating }).map(() => (
          <span class="material-symbols-outlined text-[20px] fill-current">star</span>
        ))}
      </div>
      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
        <span class="material-symbols-outlined text-[13px]">verified</span>
        Verified Client
      </span>
    </div>

    <!-- Quote -->
    <p class="text-slate-700 text-sm sm:text-base leading-relaxed italic mb-6">
      “{testimonial.quote}”
    </p>
  </div>

  <!-- Author Info -->
  <div class="flex items-center gap-4 pt-5 border-t border-slate-100">
    <img
      src={testimonial.avatar_url}
      alt={testimonial.name}
      class="w-12 h-12 rounded-full object-cover border-2 border-emerald-500/20 shadow-xs"
      loading="lazy"
    />
    <div class="flex flex-col">
      <h4 class="text-sm font-bold text-slate-900">{testimonial.name}</h4>
      <span class="text-xs text-slate-500 font-medium">
        {testimonial.role}, <strong class="text-slate-700 font-semibold">{testimonial.company}</strong>
      </span>
    </div>
  </div>
</div>
