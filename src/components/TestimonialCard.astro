---
import type { Testimonial } from '../data/pageContent';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<div class="bg-white border border-slate-200/90 p-6 sm:p-7 rounded-2xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
  <div>
    <!-- Rating Stars -->
    <div class="flex items-center gap-1 text-amber-400 mb-4">
      {Array.from({ length: testimonial.rating }).map(() => (
        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
      ))}
    </div>

    <!-- Quote -->
    <p class="text-slate-800 text-sm sm:text-base leading-relaxed italic mb-6">
      “{testimonial.quote}”
    </p>
  </div>

  <!-- Author Info -->
  <div class="flex items-center gap-3.5 pt-4 border-t border-slate-100">
    <img
      src={testimonial.avatar_url}
      alt={testimonial.name}
      class="w-12 h-12 rounded-full object-cover border border-slate-200"
      loading="lazy"
    />
    <div class="flex flex-col">
      <h4 class="text-sm font-bold text-slate-900">{testimonial.name}</h4>
      <span class="text-xs text-slate-500 font-medium">
        {testimonial.role}, {testimonial.company}
      </span>
    </div>
  </div>
</div>
