---
import '../styles/global.css';

interface Props {
  title?: string;
  activeTab?: string;
}

const { title = "Admin Portal", activeTab = "dashboard" } = Astro.props;

const navItems = [
  { id: 'dashboard', name: 'Overview', href: '/admin', icon: 'dashboard' },
  { id: 'inquiries', name: 'Inquiries', href: '/admin/inquiries', icon: 'mail', badge: '3' },
  { id: 'services', name: 'Services', href: '/admin/services', icon: 'room_service' },
  { id: 'pages', name: 'Page Content', href: '/admin/pages', icon: 'edit_document' },
  { id: 'media', name: 'Media Library', href: '/admin/media', icon: 'photo_library' },
  { id: 'settings', name: 'Settings', href: '/admin/settings', icon: 'settings' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Millennium Dev Labs Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen !flex !flex-row font-sans antialiased overflow-x-hidden">
    <!-- Sidebar Navigation -->
    <aside class="w-64 bg-[#0F172A] border-r border-slate-800 flex flex-col justify-between shrink-0 hidden md:flex h-screen sticky top-0 overflow-y-auto">
      <div class="p-6 flex flex-col gap-6">
        <!-- Logo -->
        <a href="/admin" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
            <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold text-white tracking-tight">Millennium Admin</span>
            <span class="text-[10px] text-emerald-400 font-semibold tracking-wider uppercase">Production Hub</span>
          </div>
        </a>

        <!-- Navigation items -->
        <nav class="flex flex-col space-y-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
                activeTab === item.id
                  ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-bold'
                  : 'text-slate-400 hover:text-white hover:bg-slate-800/60'
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-[18px]">{item.icon}</span>
                <span>{item.name}</span>
              </div>
              {item.badge && (
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500 text-slate-950">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>

      <!-- Bottom Profile & Status -->
      <div class="p-4 border-t border-slate-800/80 bg-slate-950/40 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors"
          >
            <span class="material-symbols-outlined text-[16px]">open_in_new</span>
            <span>View Public Site</span>
          </a>
          <span class="flex items-center gap-1 text-[10px] text-emerald-400 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> DB Online
          </span>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-800">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center font-bold text-xs">
              A
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-bold text-white">Administrator</span>
              <span class="text-[10px] text-slate-500">Superuser</span>
            </div>
          </div>
          <a href="/admin/login" class="text-slate-500 hover:text-red-400 transition-colors" title="Logout">
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-slate-950">
      <!-- Top Bar -->
      <header class="h-16 bg-[#0F172A] border-b border-slate-800 px-6 flex items-center justify-between sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <!-- Mobile Menu trigger -->
          <a href="/admin" class="md:hidden flex items-center gap-2 text-white font-bold">
            <span class="material-symbols-outlined text-emerald-400">admin_panel_settings</span>
            <span>Admin</span>
          </a>
          <h1 class="text-sm sm:text-base font-bold text-white hidden md:block">{title}</h1>
        </div>

        <div class="flex items-center gap-3">
          <!-- Quick links on mobile -->
          <div class="flex md:hidden items-center gap-2 text-xs">
            <a href="/admin/inquiries" class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-200">Inquiries</a>
            <a href="/admin/services" class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-200">Services</a>
          </div>

          <a
            href="/"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1.5 border border-slate-700 bg-slate-800/80 hover:bg-slate-800 text-xs font-semibold text-slate-200 hover:text-white px-3 py-1.5 rounded-lg transition-colors"
          >
            <span class="material-symbols-outlined text-[16px]">visibility</span>
            <span>Live Site</span>
          </a>
        </div>
      </header>

      <!-- Sub-page container -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>
    </div>
  </body>
</html>
