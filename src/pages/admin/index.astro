---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { initialInquiries } from '../../data/inquiries';
import { services } from '../../data/services';
import { portfolioItems } from '../../data/portfolio';

const activeServicesCount = services.filter(s => s.is_active).length;
---

<AdminLayout title="Dashboard Overview" activeTab="dashboard">
  <div class="flex flex-col gap-8">
    <!-- Header with Quick Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">System Overview</h2>
        <p class="text-xs text-slate-400 mt-1">Real-time statistics and incoming customer inquiries.</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/inquiries"
          class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-bold rounded-xl transition-colors shadow-sm flex items-center gap-1.5"
        >
          <span class="material-symbols-outlined text-[16px]">mail</span>
          <span>View Inquiries</span>
        </a>
        <a
          href="/admin/services"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-xl transition-colors border border-slate-700"
        >
          Manage Services
        </a>
      </div>
    </div>

    <!-- 4 Key Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-slate-400 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider">Total Inquiries</span>
          <span class="material-symbols-outlined text-emerald-400 text-[20px]">inbox</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-2xl sm:text-3xl font-extrabold text-white">{initialInquiries.length}</span>
          <span class="text-[11px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">+100% this week</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-slate-400 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider">Active Services</span>
          <span class="material-symbols-outlined text-sky-400 text-[20px]">room_service</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-2xl sm:text-3xl font-extrabold text-white">{activeServicesCount} / {services.length}</span>
          <span class="text-[11px] font-bold text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/20">All Online</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-slate-400 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider">Portfolio Items</span>
          <span class="material-symbols-outlined text-amber-400 text-[20px]">folder_special</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-2xl sm:text-3xl font-extrabold text-white">{portfolioItems.length}</span>
          <span class="text-[11px] font-bold text-slate-400">Case Studies</span>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-slate-400 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider">Storage &amp; DB</span>
          <span class="material-symbols-outlined text-emerald-400 text-[20px]">database</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-2xl sm:text-3xl font-extrabold text-white">Supabase</span>
          <span class="text-[11px] font-bold text-emerald-400 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Connected
          </span>
        </div>
      </div>
    </div>

    <!-- Recent Inquiries Table -->
    <div class="bg-[#0F172A] border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-white tracking-tight">Recent Customer Inquiries</h3>
          <p class="text-xs text-slate-400">Direct inquiries submitted through website forms.</p>
        </div>
        <a href="/admin/inquiries" class="text-xs font-semibold text-emerald-400 hover:underline">
          View All &rarr;
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800/80 bg-slate-900/50 text-[11px] font-bold uppercase tracking-wider text-slate-400">
              <th class="p-4">Customer</th>
              <th class="p-4">Service Requested</th>
              <th class="p-4">Phone / WhatsApp</th>
              <th class="p-4">Date</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-xs">
            {initialInquiries.map(inq => (
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="p-4">
                  <div class="flex flex-col">
                    <span class="font-bold text-white">{inq.customer_name}</span>
                    <span class="text-[11px] text-slate-400">{inq.email}</span>
                  </div>
                </td>
                <td class="p-4 text-slate-300">
                  {inq.service_title || "General Consultation"}
                </td>
                <td class="p-4 text-slate-300 font-mono">
                  {inq.phone}
                </td>
                <td class="p-4 text-slate-400">
                  {new Date(inq.created_at).toLocaleDateString()}
                </td>
                <td class="p-4">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase ${
                    inq.status === 'new'
                      ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                      : inq.status === 'contacted'
                      ? 'bg-sky-500/20 text-sky-400 border border-sky-500/30'
                      : 'bg-slate-800 text-slate-300'
                  }`}>
                    {inq.status}
                  </span>
                </td>
                <td class="p-4 text-right">
                  <div class="inline-flex items-center gap-1.5">
                    <a
                      href={`https://wa.me/${inq.phone.replace(/[^0-9]/g, '')}`}
                      target="_blank"
                      class="p-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 transition-colors"
                      title="WhatsApp Customer"
                    >
                      <span class="material-symbols-outlined text-[16px]">chat</span>
                    </a>
                    <a
                      href={`tel:${inq.phone.replace(/[^0-9+]/g, '')}`}
                      class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
                      title="Call Customer"
                    >
                      <span class="material-symbols-outlined text-[16px]">call</span>
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
