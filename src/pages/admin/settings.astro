---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { siteConfig } from '../../data/pageContent';
---

<AdminLayout title="Site & System Settings" activeTab="settings">
  <div class="flex flex-col gap-6 max-w-4xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">System Configuration</h2>
        <p class="text-xs text-slate-400 mt-1">
          Configure site metadata, contact routing, and third-party backend keys.
        </p>
      </div>

      <button
        type="button"
        onclick="alert('Settings saved successfully!');"
        class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-bold rounded-xl transition-colors shadow-sm flex items-center gap-1.5 self-start sm:self-auto"
      >
        <span class="material-symbols-outlined text-[18px]">save</span>
        <span>Save Configuration</span>
      </button>
    </div>

    <!-- Integrations Status -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-[22px]">database</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white">Supabase PostgreSQL</h3>
            <span class="text-[11px] text-slate-400">Database &amp; Authentication</span>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
          Ready for Keys
        </span>
      </div>

      <div class="bg-[#0F172A] border border-slate-800 p-5 rounded-2xl flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-[22px]">cloud</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white">Cloudinary CDN</h3>
            <span class="text-[11px] text-slate-400">Media &amp; Image Assets</span>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-sky-500/20 text-sky-400 border border-sky-500/30">
          Ready for Keys
        </span>
      </div>
    </div>

    <!-- Settings Form -->
    <div class="bg-[#0F172A] border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
      <h3 class="text-base font-bold text-white tracking-tight border-b border-slate-800 pb-3">
        General Contact &amp; Business Routing
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300">Website Name</label>
          <input
            type="text"
            value={siteConfig.name}
            class="w-full px-4 h-11 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300">Official Inquiries Email</label>
          <input
            type="email"
            value={siteConfig.email}
            class="w-full px-4 h-11 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300">Direct Phone Display</label>
          <input
            type="text"
            value={siteConfig.phoneDisplay}
            class="w-full px-4 h-11 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300">WhatsApp Destination Number</label>
          <input
            type="text"
            value={siteConfig.whatsappNumber}
            class="w-full px-4 h-11 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
          />
        </div>
      </div>

      <div class="space-y-1.5 pt-2">
        <label class="text-xs font-bold text-slate-300">Default WhatsApp Lead Message</label>
        <input
          type="text"
          value={siteConfig.whatsappMessage}
          class="w-full px-4 h-11 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
        />
      </div>
    </div>
  </div>
</AdminLayout>
