---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { siteConfig } from '../data/pageContent';
---

<Layout
  title="Contact Us — Direct Developer Communication | Millennium Dev Labs"
  description="Connect directly with our lead engineers via WhatsApp, phone, email, or direct service inquiry. Fast responses within 2 hours."
>
  <!-- Hero Section -->
  <section class="relative w-full bg-[#0F172A] text-white py-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#dae2fd_1px,transparent_1px)] [background-size:20px_20px]"></div>
    <div class="absolute right-0 top-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10 flex flex-col gap-4">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-white">Contact Us</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 text-xs font-bold mb-3 border border-emerald-500/30">
            <span>⚡ Quick Response • Direct Developer Communication</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Let's Talk About Your Project
          </h1>
          <p class="text-base sm:text-lg text-slate-300 mt-2 leading-relaxed">
            Have an idea, need a redesign, or working with a target budget? Reach out directly—we reply promptly and work around your goals.
          </p>
        </div>

        <div class="bg-slate-800/80 border border-slate-700 p-4 rounded-2xl flex items-center gap-3 shrink-0">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-[22px]">waving_hand</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 font-medium block">Questions first?</span>
            <span class="text-xs font-bold text-white">We're online &amp; ready to chat</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-Column Contact & Form Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Direct Fast Channels (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- 1. Highlight Card: WhatsApp Priority -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border-2 border-emerald-500 shadow-md relative overflow-hidden transition-all hover:shadow-xl">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <span class="material-symbols-outlined text-[26px]">chat</span>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600">Recommended Fast Channel</span>
              <h3 class="text-lg font-bold text-slate-900">Direct WhatsApp Chat</h3>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-5">
            Instant messaging directly with our lead engineer. Share your sketches, budget, or live links for immediate discussion.
          </p>
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white h-11 rounded-xl text-xs font-bold transition-all shadow-md shadow-emerald-500/20"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Open WhatsApp Conversation</span>
          </a>
        </div>

        <!-- 2. Telephone Call Card -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-center justify-between hover:border-slate-300 transition-colors">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">call</span>
            </div>
            <div>
              <span class="text-[11px] font-semibold text-slate-400 block uppercase tracking-wider">Phone Support</span>
              <span class="text-sm font-bold text-slate-900">{siteConfig.phoneDisplay}</span>
            </div>
          </div>
          <a
            href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
            class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors"
          >
            Call
          </a>
        </div>

        <!-- 3. Direct Email Card -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-center justify-between hover:border-slate-300 transition-colors">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">mail</span>
            </div>
            <div>
              <span class="text-[11px] font-semibold text-slate-400 block uppercase tracking-wider">Official Email</span>
              <span class="text-sm font-bold text-slate-900">{siteConfig.email}</span>
            </div>
          </div>
          <a
            href={`mailto:${siteConfig.email}`}
            class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors"
          >
            Email
          </a>
        </div>

        <!-- 4. Location & Working Hours -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col gap-3 text-xs text-slate-600">
          <div class="flex items-center gap-2 font-bold text-slate-900">
            <span class="material-symbols-outlined text-emerald-500 text-[18px]">schedule</span>
            <span>Working Hours &amp; Location</span>
          </div>
          <p>{siteConfig.workingHours}</p>
          <p class="text-slate-500">{siteConfig.location}</p>
        </div>
      </div>

      <!-- Right Column: Interactive Inquiry Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Inquiry Submission</span>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-1">Send a Detailed Request</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Fill out the form below and we will prepare a milestone estimate and preliminary architecture draft.
          </p>
        </div>
        <InquiryForm />
      </div>
    </div>
  </section>
</Layout>
