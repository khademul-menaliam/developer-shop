---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import PricingSection from '../../components/PricingSection.astro';
import MethodologySection from '../../components/MethodologySection.astro';
import { services } from '../../data/services';
---

<Layout
  title="Capabilities & Services — Apex Services"
  description="Explore our full range of web development, mobile applications, cloud deployments, security audits, and business intelligence solutions."
>
  <!-- Hero Banner -->
  <section class="relative w-full bg-[#0F172A] text-white py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#dae2fd_1px,transparent_1px)] [background-size:20px_20px]"></div>
    <div class="absolute right-0 top-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10 flex flex-col gap-4">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-white">Services</span>
      </nav>

      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">
          Engineered Capabilities
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mt-1 mb-4">
          Precision Managed Web &amp; Data Services
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Scalable digital infrastructure, rigorous cybersecurity, and actionable business intelligence designed to help regional businesses dominate their market.
        </p>
      </div>
    </div>
  </section>

  <!-- All 6 Services Grid -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map(service => (
        <ServiceCard service={service} />
      ))}
    </div>
  </section>

  <!-- Pricing Plans Section -->
  <PricingSection />

  <!-- Methodology Section -->
  <MethodologySection />

  <!-- CTA Banner -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="bg-[#0F172A] rounded-3xl p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col gap-2 max-w-2xl z-10">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">
          Ready to begin?
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Need a customized solution tailored to your operational scale?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300">
          Talk to our engineering leads today for an immediate assessment and customized architecture draft.
        </p>
      </div>

      <div class="z-10 shrink-0">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white px-6 h-12 rounded-xl text-xs font-bold transition-all shadow-md shadow-emerald-500/25"
        >
          <span class="material-symbols-outlined text-[18px]">calendar_today</span>
          <span>Schedule Technical Consultation</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
