---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import PricingSection from '../components/PricingSection.astro';
import MethodologySection from '../components/MethodologySection.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { services } from '../data/services';
import { portfolioItems } from '../data/portfolio';
import { testimonials, faqs } from '../data/pageContent';

const featuredServices = services.slice(0, 3);
const featuredProjects = portfolioItems.filter(p => p.featured).slice(0, 3);
---

<Layout
  title="Apex Services — High-Performance Regional Web & Digital Systems"
  description="Transformative web architecture, responsive portfolios, mobile apps, and dedicated DevOps care for growing businesses."
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Statistics Counter -->
  <StatsCounter />

  <!-- 3. Core Capabilities / Services Preview -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full" id="services">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">
          Core Capabilities
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">
          Tailored Solutions for Modern Enterprise
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <p class="text-sm text-slate-600 max-w-md">
          Engineered for scale, security, and high reliability across all regional operations.
        </p>
        <a
          href="/services"
          class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 hover:text-emerald-700 transition-colors whitespace-nowrap"
        >
          <span>All 6 Services</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>
    </div>

    <!-- 3 Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {featuredServices.map(service => (
        <ServiceCard service={service} />
      ))}
    </div>
  </section>

  <!-- 4. Featured Project Portfolio -->
  <section class="py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">
            Track Record
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">
            Featured Regional Deployments
          </h2>
        </div>
        <a
          href="/portfolio"
          class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 hover:text-emerald-700 transition-colors"
        >
          <span>View All Case Studies</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {featuredProjects.map(project => (
          <PortfolioCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Transparent Budget-Friendly Pricing -->
  <PricingSection />

  <!-- 6. Structured Operational Methodology (4-step) -->
  <MethodologySection />

  <!-- 7. Verified Client Testimonials -->
  <section class="py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <div class="text-center max-w-2xl mx-auto flex flex-col gap-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">
          Client Feedback
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          Trusted by Regional Leaders
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Read what founders, CTOs, and directors say about our delivery speed and architectural quality.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {testimonials.map(testimonial => (
          <TestimonialCard testimonial={testimonial} />
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Frequently Asked Questions (Accordion) -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
    <div class="text-center max-w-2xl mx-auto mb-12 flex flex-col gap-2">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">
        Got Questions?
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-sm text-slate-600">
        Clear answers about our development process, hosting costs, and delivery guarantees.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 transition-all duration-200 open:shadow-md open:border-emerald-500/50">
          <summary class="flex items-center justify-between cursor-pointer list-none text-slate-900 font-bold text-base sm:text-lg">
            <span>{faq.question}</span>
            <span class="w-8 h-8 rounded-full bg-slate-100 group-open:bg-emerald-50 text-slate-500 group-open:text-emerald-600 flex items-center justify-center shrink-0 ml-4 transition-transform group-open:rotate-180">
              <span class="material-symbols-outlined text-[20px]">expand_more</span>
            </span>
          </summary>
          <div class="pt-4 mt-3 border-t border-slate-100 text-sm text-slate-600 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- 9. Quick Inquiry / Booking Section -->
  <section class="py-20 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 relative overflow-hidden" id="inquire">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-4xl mx-auto flex flex-col gap-8 relative z-10">
      <div class="text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">
          Get In Touch
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mt-1">
          Start Your Project Today
        </h2>
        <p class="text-sm text-slate-300 mt-2">
          Tell us about your organization's goals and target timeline. We will review your requirements and respond within 2 hours.
        </p>
      </div>

      <!-- Interactive Inquiry Form -->
      <InquiryForm />
    </div>
  </section>
</Layout>
