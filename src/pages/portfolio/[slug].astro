---
import Layout from '../../layouts/Layout.astro';
import { portfolioItems } from '../../data/portfolio';

export function getStaticPaths() {
  return portfolioItems.map(project => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Case Study | Millennium Dev Labs`}
  description={project.summary}
  image={project.image_url}
>
  <!-- Hero Section -->
  <section class="relative w-full bg-slate-950 text-white py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05] bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="absolute right-0 top-0 w-96 h-96 bg-sky-500/[0.08] rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto relative z-10 flex flex-col gap-4">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-sky-300 transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <a href="/portfolio" class="hover:text-sky-300 transition-colors">Portfolio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-white">{project.client}</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-950/80 text-sky-300 text-xs font-bold mb-3 border border-sky-500/30">
          <span>{project.category}</span>
          <span>•</span>
          <span>{project.year}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mt-1 mb-4 leading-tight">
          {project.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          {project.summary}
        </p>
      </div>
    </div>
  </section>

  <!-- Case Study Content -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
    <!-- Featured Screenshot Banner -->
    <div class="w-full h-80 sm:h-96 md:h-[480px] rounded-3xl overflow-hidden shadow-2xl border border-slate-200 mb-12 relative bg-slate-900">
      <img
        src={project.image_url}
        alt={project.title}
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Metadata Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 bg-white border border-slate-200 rounded-2xl shadow-xs mb-12">
      <div>
        <span class="text-[11px] font-bold uppercase text-slate-400 block">Client</span>
        <span class="text-sm font-bold text-slate-900">{project.client}</span>
      </div>
      <div>
        <span class="text-[11px] font-bold uppercase text-slate-400 block">Domain</span>
        <span class="text-sm font-bold text-slate-900">{project.category}</span>
      </div>
      <div>
        <span class="text-[11px] font-bold uppercase text-slate-400 block">Year</span>
        <span class="text-sm font-bold text-slate-900">{project.year}</span>
      </div>
      <div>
        <span class="text-[11px] font-bold uppercase text-slate-400 block">Delivery</span>
        <span class="text-sm font-bold text-sky-600">Production Live</span>
      </div>
    </div>

    <!-- Narrative Section: Challenge & Solution -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Challenge -->
      <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col gap-4">
        <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px]">report_problem</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900">The Challenge</h2>
        <p class="text-sm text-slate-600 leading-relaxed font-normal">
          {project.challenge}
        </p>
      </div>

      <!-- Solution -->
      <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col gap-4">
        <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px]">verified</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900">The Solution</h2>
        <p class="text-sm text-slate-600 leading-relaxed font-normal">
          {project.solution}
        </p>
      </div>
    </div>

    <!-- Measured Impact & Results -->
    <div class="bg-slate-950 text-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-800 mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-sky-400">
        Key Metrics
      </span>
      <h2 class="text-2xl font-extrabold text-white mt-1 mb-6">
        Verified Production Impact
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {project.results.map((res, i) => (
          <div class="p-5 bg-slate-900 rounded-2xl border border-slate-800 flex flex-col gap-2">
            <span class="text-sky-400 font-extrabold text-lg">0{i + 1}</span>
            <span class="text-xs sm:text-sm text-slate-200 leading-relaxed font-medium">{res}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Technologies Used -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 mb-12 shadow-xs">
      <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
        Technology Stack Implemented
      </h3>
      <div class="flex flex-wrap gap-2">
        {project.tags.map(tag => (
          <span class="px-3 py-1 rounded-xl text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Bottom Navigation -->
    <div class="flex items-center justify-between border-t border-slate-200 pt-8">
      <a
        href="/portfolio"
        class="inline-flex items-center gap-1 text-xs font-bold text-slate-600 hover:text-sky-600 transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        <span>Back to All Projects</span>
      </a>

      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold px-5 h-11 rounded-xl transition-all shadow-md shadow-sky-950/20"
      >
        <span>Build a Similar Platform</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </section>
</Layout>
